{
  "openapi": "3.1.0",
  "info": {
    "title": "RAHO Admin and WhatsApp Internal API",
    "version": "6.0.0-phase6",
    "description": "Source contract for the versioned admin boundary. Browser mutations require the session cookie and X-CSRF-Token. Tenant context is derived only from the immutable session."
