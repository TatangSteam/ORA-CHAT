  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "raho_session" },
      "internalBearer": { "type": "http", "scheme": "bearer" }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "Csrf": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 32 }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "required": ["requestId", "traceId"],
        "properties": {
          "requestId": { "type": "string" },
          "traceId": { "type": "string" },
          "nextCursor": { "type": ["string", "null"], "format": "uuid" },
          "hasMore": { "type": "boolean" }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": { "data": {}, "meta": { "$ref": "#/components/schemas/Meta" } }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Versioned success envelope",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } }
        }
      },
      "Error": {
        "description": "Safe error envelope",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      }
    }
  }
