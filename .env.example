# Non-secret local Compose settings. Generate credentials with `corepack pnpm secrets:init`.
COMPOSE_PROJECT_NAME=raho-whatsapp-chatbot-v2

WEB_PORT=3000
API_PORT=4000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Nomor WhatsApp pribadi CS penerima notifikasi handoff AI. Contoh: 081234567890.
# Kosongkan untuk menonaktifkan notifikasi tanpa mematikan fitur handoff.
CS_WHATSAPP_NOTIFICATION_PHONE=

POSTGRES_DB=raho_chatbot
POSTGRES_USER=raho_app
