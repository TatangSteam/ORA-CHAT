{
  "name": "@raho/whatsapp-chatbot-v2",
  "version": "0.0.0",
  "private": true,
  "description": "RAHO WhatsApp Chatbot V2 monorepo",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --sort --if-present build",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "lint": "eslint apps packages *.config.* --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "corepack pnpm --recursive --sort --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.0.15",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
