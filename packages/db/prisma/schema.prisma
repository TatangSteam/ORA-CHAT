generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                        String                         @id @db.Uuid
  slug                      String                         @unique @db.VarChar(64)
  name                      String                         @db.VarChar(160)
  status                    String                         @default("active") @db.VarChar(24)
  createdAt                 DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships               AdminTenantMembership[]
  auditLogs                 AuditLog[]
  whatsappState             WhatsAppSessionState?
  safetyState               SafetyControlState?
  contacts                  Contact[]
  conversations             Conversation[]
  messages                  Message[]
  messageEvents             MessageEvent[]
  outboxMessages            OutboxMessage[]
  idempotencyKeys           IdempotencyKey[]
  handoffTasks              HandoffTask[]
  handoffNotification       HandoffNotificationSetting?
  ruleVersions              ChatbotRuleVersion[]
  chatbotRules              ChatbotRule[]
  aiIntegrations            AiIntegration[]
  aiCredentials             AiProviderCredential[]
  aiConnections             AiProviderConnection[]
  aiCapabilities            AiModelCapabilityCache[]
  embeddingIndexes          EmbeddingIndexVersion[]
  knowledgeCategories       KnowledgeCategory[]
  knowledgeItems            KnowledgeItem[]
  knowledgeDocuments        KnowledgeDocument[]
  knowledgeObjects          KnowledgeStorageObject[]
  knowledgeChunks           KnowledgeChunk[]
  knowledgeLexicalChunks    KnowledgeLexicalChunk[]
  aiPromptVersions          AiPromptVersion[]
  aiMessageTraces           AiMessageTrace[]
  aiResponseCaches          AiResponseCache[]
  aiEmbeddingUsage          AiEmbeddingUsageLog[]
  aiAdminFeedback           AiAdminFeedback[]
  unansweredQuestions       UnansweredQuestion[]
  unansweredOccurrences     UnansweredQuestionOccurrence[]
  aiTestCases               AiTestCase[]
  aiTestRuns                AiTestRun[]
  aiReleaseReadiness        AiReleaseReadiness[]
  aiEvaluationReports       AiEvaluationReport[]
  operationalAlerts         AiOperationalAlert[]
  messageTemplates          MessageTemplate[]
  messageTemplateVersions   MessageTemplateVersion[]
  templateChecklistItems    TemplateChecklistItem[]
  messageTemplateSnapshots  MessageTemplateSnapshot[]
  messageChecklistSnapshots MessageChecklistItemSnapshot[]

  @@map("tenants")
}

model AdminUser {
  id                         String                         @id @db.Uuid
  username                   String                         @unique @db.VarChar(64)
  passwordHash               String                         @map("password_hash") @db.VarChar(512)
  displayName                String                         @map("display_name") @db.VarChar(160)
  status                     String                         @default("active") @db.VarChar(24)
  lastLoginAt                DateTime?                      @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt          DateTime                       @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt                  DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships                AdminTenantMembership[]
  auditLogs                  AuditLog[]
  ownedConversations         Conversation[]                 @relation("ConversationOwner")
  assignedHandoffs           HandoffTask[]                  @relation("HandoffAssignee")
  updatedHandoffNotification HandoffNotificationSetting[]   @relation("HandoffNotificationUpdater")
  createdRuleVersions        ChatbotRuleVersion[]           @relation("RuleVersionCreator")
  publishedRuleVersions      ChatbotRuleVersion[]           @relation("RuleVersionPublisher")
  aiFeedbackReviews          AiAdminFeedback[]
  createdAiTestCases         AiTestCase[]
  readinessDecisions         AiReleaseReadiness[]
  createdMessageTemplates    MessageTemplate[]              @relation("TemplateCreator")
  createdTemplateVersions    MessageTemplateVersion[]       @relation("TemplateVersionCreator")
  publishedTemplateVersions  MessageTemplateVersion[]       @relation("TemplateVersionPublisher")
  checkedTemplateItems       MessageChecklistItemSnapshot[] @relation("TemplateChecklistVerifier")

  @@map("admin_users")
}

model AdminTenantMembership {
  id                  String         @id @db.Uuid
  adminUserId         String         @map("admin_user_id") @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  role                String         @db.VarChar(32)
  permissionOverrides Json           @default("{\"grant\":[],\"deny\":[]}") @map("permission_overrides") @db.JsonB
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  adminUser           AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions            AdminSession[]

  @@unique([adminUserId, tenantId])
  @@unique([id, adminUserId, tenantId])
  @@index([tenantId, role, id])
  @@map("admin_tenant_memberships")
}

model AdminSession {
  id             String                @id @db.Uuid
  membershipId   String                @map("membership_id") @db.Uuid
  adminUserId    String                @map("admin_user_id") @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  tokenHash      String                @unique @map("token_hash") @db.Char(64)
  csrfSecretHash String                @map("csrf_secret_hash") @db.Char(64)
  ipHash         String                @map("ip_hash") @db.Char(64)
  userAgentHash  String                @map("user_agent_hash") @db.Char(64)
  expiresAt      DateTime              @map("expires_at") @db.Timestamptz(3)
  idleExpiresAt  DateTime              @map("idle_expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason  String?               @map("revoked_reason") @db.VarChar(80)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  membership     AdminTenantMembership @relation(fields: [membershipId, adminUserId, tenantId], references: [id, adminUserId, tenantId], onDelete: Restrict)

  @@index([adminUserId, revokedAt, expiresAt])
  @@index([tenantId, revokedAt, expiresAt])
  @@map("admin_sessions")
}

model AuditLog {
  id          String     @id @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  action      String     @db.VarChar(96)
  entityType  String     @map("entity_type") @db.VarChar(80)
  entityId    String?    @map("entity_id") @db.VarChar(160)
  reason      String?    @db.VarChar(500)
  requestId   String     @map("request_id") @db.VarChar(80)
  metadata    Json       @default("{}") @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser   AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc), id])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model WhatsAppSessionState {
  tenantId        String    @id @map("tenant_id") @db.Uuid
  adapter         String    @default("baileys") @db.VarChar(32)
  state           String    @default("logged_out") @db.VarChar(32)
  connectedJid    String?   @map("connected_jid") @db.VarChar(160)
  authStorageRef  String?   @map("auth_storage_ref") @db.VarChar(500)
  lastErrorCode   String?   @map("last_error_code") @db.VarChar(80)
  connectedAt     DateTime? @map("connected_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz(3)
  revision        Int       @default(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("whatsapp_session_states")
}

model SafetyControlState {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  sendingPaused Boolean  @default(false) @map("sending_paused")
  killSwitch    Boolean  @default(false) @map("kill_switch")
  riskLevel     String   @default("low") @map("risk_level") @db.VarChar(24)
  reason        String?  @db.VarChar(500)
  changedBy     String?  @map("changed_by") @db.Uuid
  revision      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("safety_control_states")
}

model Contact {
  id              String         @id @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  displayName     String?        @map("display_name") @db.VarChar(160)
  normalizedPhone String         @map("normalized_phone") @db.VarChar(20)
  providerJid     String?        @map("provider_jid") @db.VarChar(160)
  consentStatus   String         @default("unknown") @map("consent_status") @db.VarChar(24)
  lastInboundAt   DateTime?      @map("last_inbound_at") @db.Timestamptz(3)
  lastOutboundAt  DateTime?      @map("last_outbound_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversations   Conversation[]

  @@unique([tenantId, normalizedPhone])
  @@unique([tenantId, providerJid])
  @@index([tenantId, displayName, id])
  @@map("contacts")
}

model Conversation {
  id               String        @id @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  contactId        String        @map("contact_id") @db.Uuid
  ownerUserId      String?       @map("owner_user_id") @db.Uuid
  channel          String        @default("whatsapp") @db.VarChar(24)
  status           String        @default("open") @db.VarChar(24)
  handlingMode     String        @default("bot") @map("handling_mode") @db.VarChar(24)
  unreadCount      Int           @default(0) @map("unread_count")
  followUpRequired Boolean       @default(false) @map("follow_up_required")
  lastMessageAt    DateTime?     @map("last_message_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contact          Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  ownerUser        AdminUser?    @relation("ConversationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  messages         Message[]
  handoffTasks     HandoffTask[]

  @@unique([tenantId, contactId, channel])
  @@index([tenantId, status, lastMessageAt(sort: Desc), id])
  @@map("conversations")
}

model Message {
  id                String                   @id @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  conversationId    String                   @map("conversation_id") @db.Uuid
  replyToMessageId  String?                  @map("reply_to_message_id") @db.Uuid
  direction         String                   @db.VarChar(16)
  source            String                   @db.VarChar(24)
  messageType       String                   @default("text") @map("message_type") @db.VarChar(24)
  content           String                   @db.VarChar(4096)
  status            String                   @db.VarChar(24)
  providerMessageId String?                  @map("provider_message_id") @db.VarChar(191)
  occurredAt        DateTime                 @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation      Conversation             @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  replyToMessage    Message?                 @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: Restrict)
  replies           Message[]                @relation("MessageReply")
  events            MessageEvent[]
  outbox            OutboxMessage?
  triggeredHandoffs HandoffTask[]
  templateSnapshot  MessageTemplateSnapshot?

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, conversationId, occurredAt(sort: Desc), id])
  @@map("messages")
}

model MessageEvent {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  messageId       String   @map("message_id") @db.Uuid
  eventType       String   @map("event_type") @db.VarChar(48)
  fromStatus      String?  @map("from_status") @db.VarChar(24)
  toStatus        String   @map("to_status") @db.VarChar(24)
  providerEventId String?  @map("provider_event_id") @db.VarChar(191)
  safeMetadata    Json     @default("{}") @map("safe_metadata") @db.JsonB
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([tenantId, providerEventId])
  @@index([tenantId, messageId, occurredAt, id])
  @@map("message_events")
}

model OutboxMessage {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  messageId          String    @unique @map("message_id") @db.Uuid
  status             String    @default("queued") @db.VarChar(24)
  deterministicJobId String    @map("deterministic_job_id") @db.VarChar(96)
  attemptCount       Int       @default(0) @map("attempt_count")
  maxAttempts        Int       @default(5) @map("max_attempts")
  availableAt        DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseExpiresAt     DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  leasedBy           String?   @map("leased_by") @db.VarChar(120)
  deliveryAttemptId  String?   @map("delivery_attempt_id") @db.Uuid
  lastErrorCode      String?   @map("last_error_code") @db.VarChar(80)
  dispatchedAt       DateTime? @map("dispatched_at") @db.Timestamptz(3)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  message            Message   @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([tenantId, deterministicJobId])
  @@index([tenantId, status, availableAt])
  @@map("outbox_messages")
}

model MessageTemplate {
  id              String                   @id @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  name            String                   @db.VarChar(160)
  category        String                   @db.VarChar(64)
  status          String                   @default("inactive") @db.VarChar(24)
  currentVersion  Int                      @default(1) @map("current_version")
  createdByUserId String                   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByUser   AdminUser                @relation("TemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        MessageTemplateVersion[]

  @@index([tenantId, status, updatedAt(sort: Desc), id])
  @@map("message_templates")
}

model MessageTemplateVersion {
  id                String                    @id @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  templateId        String                    @map("template_id") @db.Uuid
  version           Int
  status            String                    @default("draft") @db.VarChar(24)
  body              String                    @db.VarChar(4096)
  variableSchema    Json                      @map("variable_schema") @db.JsonB
  createdByUserId   String                    @map("created_by_user_id") @db.Uuid
  publishedByUserId String?                   @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime?                 @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template          MessageTemplate           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdByUser     AdminUser                 @relation("TemplateVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedByUser   AdminUser?                @relation("TemplateVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  checklistItems    TemplateChecklistItem[]
  snapshots         MessageTemplateSnapshot[]

  @@unique([templateId, version])
  @@index([tenantId, templateId, createdAt(sort: Desc), id])
  @@map("message_template_versions")
}

model TemplateChecklistItem {
  id                String                         @id @db.Uuid
  tenantId          String                         @map("tenant_id") @db.Uuid
  templateVersionId String                         @map("template_version_id") @db.Uuid
  sequence          Int
  label             String                         @db.VarChar(240)
  required          Boolean                        @default(true)
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  templateVersion   MessageTemplateVersion         @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  snapshots         MessageChecklistItemSnapshot[]

  @@unique([templateVersionId, sequence])
  @@index([tenantId, templateVersionId, sequence])
  @@map("template_checklist_items")
}

model MessageTemplateSnapshot {
  id                      String                         @id @db.Uuid
  tenantId                String                         @map("tenant_id") @db.Uuid
  messageId               String                         @unique @map("message_id") @db.Uuid
  sourceTemplateVersionId String                         @map("source_template_version_id") @db.Uuid
  renderedBody            String                         @map("rendered_body") @db.VarChar(4096)
  resolvedVariables       Json                           @map("resolved_variables") @db.JsonB
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                  Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  message                 Message                        @relation(fields: [messageId], references: [id], onDelete: Restrict)
  sourceTemplateVersion   MessageTemplateVersion         @relation(fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  checklistItems          MessageChecklistItemSnapshot[]

  @@index([tenantId, createdAt(sort: Desc), id])
  @@map("message_template_snapshots")
}

model MessageChecklistItemSnapshot {
  id                    String                  @id @db.Uuid
  tenantId              String                  @map("tenant_id") @db.Uuid
  templateSnapshotId    String                  @map("template_snapshot_id") @db.Uuid
  sourceChecklistItemId String?                 @map("source_checklist_item_id") @db.Uuid
  sequence              Int
  label                 String                  @db.VarChar(240)
  required              Boolean
  checked               Boolean                 @default(false)
  checkedByUserId       String?                 @map("checked_by_user_id") @db.Uuid
  checkedAt             DateTime?               @map("checked_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  templateSnapshot      MessageTemplateSnapshot @relation(fields: [templateSnapshotId], references: [id], onDelete: Restrict)
  sourceChecklistItem   TemplateChecklistItem?  @relation(fields: [sourceChecklistItemId], references: [id], onDelete: Restrict)
  checkedByUser         AdminUser?              @relation("TemplateChecklistVerifier", fields: [checkedByUserId], references: [id], onDelete: Restrict)

  @@unique([templateSnapshotId, sequence])
  @@index([tenantId, templateSnapshotId, sequence])
  @@map("message_checklist_item_snapshots")
}

model IdempotencyKey {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  scope            String   @db.VarChar(64)
  key              String   @db.VarChar(128)
  requestHash      String   @map("request_hash") @db.Char(64)
  resourceType     String   @map("resource_type") @db.VarChar(64)
  resourceId       String   @map("resource_id") @db.Uuid
  responseStatus   Int      @map("response_status")
  responseSnapshot Json     @map("response_snapshot") @db.JsonB
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, scope, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_keys")
}

model HandoffTask {
  id               String       @id @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  conversationId   String       @map("conversation_id") @db.Uuid
  triggerMessageId String?      @map("trigger_message_id") @db.Uuid
  assigneeUserId   String?      @map("assignee_user_id") @db.Uuid
  reasonCode       String       @map("reason_code") @db.VarChar(64)
  priority         String       @default("normal") @db.VarChar(16)
  status           String       @default("open") @db.VarChar(24)
  resolutionNote   String?      @map("resolution_note") @db.VarChar(1000)
  assignedAt       DateTime?    @map("assigned_at") @db.Timestamptz(3)
  resolvedAt       DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  triggerMessage   Message?     @relation(fields: [triggerMessageId], references: [id], onDelete: Restrict)
  assigneeUser     AdminUser?   @relation("HandoffAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, priority, createdAt])
  @@map("handoff_tasks")
}

model HandoffNotificationSetting {
  tenantId        String    @id @map("tenant_id") @db.Uuid
  normalizedPhone String?   @map("normalized_phone") @db.VarChar(20)
  enabled         Boolean   @default(false)
  revision        Int       @default(0)
  updatedByUserId String    @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  updatedByUser   AdminUser @relation("HandoffNotificationUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("handoff_notification_settings")
}

model ChatbotRuleVersion {
  id                String        @id @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  version           Int
  status            String        @default("draft") @db.VarChar(24)
  revision          Int           @default(0)
  greeting          String?       @db.VarChar(4096)
  fallback          String        @db.VarChar(4096)
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  publishedByUserId String?       @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByUser     AdminUser?    @relation("RuleVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedByUser   AdminUser?    @relation("RuleVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  rules             ChatbotRule[]

  @@unique([tenantId, version])
  @@index([tenantId, status, version(sort: Desc)])
