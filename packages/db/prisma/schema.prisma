  id                   String             @id @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  unansweredQuestionId String             @map("unanswered_question_id") @db.Uuid
  traceId              String?            @map("trace_id") @db.Uuid
  conversationId       String?            @map("conversation_id") @db.Uuid
  occurredAt           DateTime           @map("occurred_at") @db.Timestamptz(3)
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unansweredQuestion   UnansweredQuestion @relation(fields: [unansweredQuestionId], references: [id], onDelete: Restrict)
  trace                AiMessageTrace?    @relation(fields: [traceId], references: [id], onDelete: Restrict)

  @@index([tenantId, unansweredQuestionId, occurredAt(sort: Desc), id])
  @@map("unanswered_question_occurrences")
}

model AiTestCase {
  id               String      @id @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  name             String      @db.VarChar(160)
  input            String      @db.VarChar(2000)
  expectedBehavior Json        @map("expected_behavior") @db.JsonB
  status           String      @default("active") @db.VarChar(24)
  createdByUserId  String      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy        AdminUser   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  runs             AiTestRun[]

  @@unique([tenantId, name])
  @@index([tenantId, status, updatedAt(sort: Desc), id])
  @@map("ai_test_cases")
}

model AiTestRun {
  id              String     @id @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  testCaseId      String     @map("test_case_id") @db.Uuid
  integrationId   String     @map("integration_id") @db.Uuid
  status          String     @db.VarChar(24)
  actualResult    Json       @map("actual_result") @db.JsonB
  assertionResult Json       @map("assertion_result") @db.JsonB
  latencyMs       Int        @map("latency_ms")
  startedAt       DateTime   @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime   @map("finished_at") @db.Timestamptz(3)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  testCase        AiTestCase @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  @@index([tenantId, testCaseId, startedAt(sort: Desc), id])
  @@index([tenantId, status, startedAt(sort: Desc), id])
  @@map("ai_test_runs")
}

model AiReleaseReadiness {
  id              String               @id @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  integrationId   String               @map("integration_id") @db.Uuid
  revision        Int                  @default(0)
  status          String               @default("blocked") @db.VarChar(24)
  gateResults     Json                 @map("gate_results") @db.JsonB
  pilotPercentage Int                  @default(0) @map("pilot_percentage")
  blockers        Json                 @default("[]") @db.JsonB
  decidedByUserId String?              @map("decided_by_user_id") @db.Uuid
  evaluatedAt     DateTime             @map("evaluated_at") @db.Timestamptz(3)
  decidedAt       DateTime?            @map("decided_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  decidedBy       AdminUser?           @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)
  reports         AiEvaluationReport[]

  @@index([tenantId, evaluatedAt(sort: Desc), id])
  @@map("ai_release_readiness")
}

model AiEvaluationReport {
  id          String             @id @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  readinessId String             @map("readiness_id") @db.Uuid
  reportType  String             @map("report_type") @db.VarChar(32)
  totalCases  Int                @map("total_cases")
  passedCases Int                @map("passed_cases")
  failedCases Int                @map("failed_cases")
  score       Decimal            @db.Decimal(5, 4)
  metrics     Json               @db.JsonB
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  readiness   AiReleaseReadiness @relation(fields: [readinessId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc), id])
  @@map("ai_evaluation_reports")
}

model AiOperationalAlert {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  fingerprint     String    @db.Char(64)
  severity        String    @db.VarChar(16)
  code            String    @db.VarChar(64)
  summary         String    @db.VarChar(500)
  safeMetadata    Json      @default("{}") @map("safe_metadata") @db.JsonB
  status          String    @default("open") @db.VarChar(24)
  firstSeenAt     DateTime  @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime  @map("last_seen_at") @db.Timestamptz(3)
  occurrenceCount Int       @default(1) @map("occurrence_count")
  acknowledgedAt  DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status, severity, lastSeenAt(sort: Desc), id])
  @@map("ai_operational_alerts")
}
